# Copia estos valores en Dokploy → tu proyecto → Environment.
# (No subas el archivo .env real a GitHub: tiene llaves secretas.)

# Dirección pública de la app. Los stickers QR apuntan aquí.
PUBLIC_URL=https://frescotrack.korensmx.com

# Llave para las sesiones. OBLIGATORIA, mínimo 32 caracteres al azar (por ejemplo: openssl rand -hex 32).
JWT_SECRET=

# Tu Evolution API (para mandar WhatsApp automático). Déjalo vacío para usar solo ligas wa.me.
EVOLUTION_API_URL=https://evolution.tu-dominio.com
EVOLUTION_API_KEY=

# Mercado Pago (cobro de la suscripción Pro). Lo sacas de mercadopago.com.mx/developers → Tus integraciones.
MP_ACCESS_TOKEN=
# "Clave secreta" de Webhooks en Mercado Pago (para comprobar que los avisos son reales). Muy recomendable.
MP_WEBHOOK_SECRET=
PRO_PRICE_MXN=299

# WhatsApp de soporte de KORENS (10 dígitos), opcional.
SUPPORT_PHONE=

# Llave para que n8n lea el reporte de ventas y fallas (32+ caracteres: openssl rand -hex 32)
ADMIN_TOKEN=
